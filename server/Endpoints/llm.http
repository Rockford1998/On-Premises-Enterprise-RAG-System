### List, with optional ?provider= / ?isActive= / ?page= / ?size=
GET http://localhost:3000/llm
Authorization: Bearer {{token}}

### Minimal metadata only (name + _id), used to populate model pickers
GET http://localhost:3000/metadata/models
Authorization: Bearer {{token}}

### Get by _id — route param is :id, must match the controller's req.params.id
GET http://localhost:3000/llm/68a16a5c513f9ec57abcf664
Authorization: Bearer {{token}}


###
POST http://localhost:3000/llm
Content-Type:  application/json
Authorization: Bearer {{token}}

{
    "name": "gpt-oss:120b-cloud",
    "provider":"ollama",
    "endpoint": "",
    "isActive": true,
    "description": "Cloud-hosted chat model used as BASE_MODEL / TOOL_MODEL in dev.",
    "tags": ["chat", "cloud", "tool-calling"],
    "meta": {
      "contextWindow": "128k",
      "maxOutputTokens": 16000,
      "modelType": "chat",
      "inputPrice": 0,
      "outputPrice": 0,
      "inputType":"text",
      "supportsTools": true,
      "supportsStreaming": true
    }
}


###
POST http://localhost:3000/llm
Content-Type:  application/json
Authorization: Bearer {{token}}

{
    "name": "nomic-embed-text",
    "provider":"ollama",
    "endpoint": "",
    "isActive": true,
    "description": "Local 768-dim embedding model — matches the dimension every existing vector_table_* was created with.",
    "tags": ["embedding", "local"],
    "meta": {
      "contextWindow": "8k",
      "modelType": "embedding",
      "inputPrice": 0,
      "outputPrice": 0,
      "inputType":"text",
      "supportsTools": false,
      "supportsStreaming": false
    }
}


