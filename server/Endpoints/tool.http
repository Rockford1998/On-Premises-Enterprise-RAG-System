"type": "string",
"description": "The city name to get weather for.",
"required": true,
"in": "query",
"mapTo": "q"
}
},
  "type": "http",
  "endpoint": "http://api.weatherapi.com/v1/current.json?aqi=no",
  "method": "GET",
  "headers": {
    "Content-Type": "application/json"
  }, 
  "auth": {
    "type": "apiKey", // basic or bearer or none
    "apiKey": "4e7797131c1d4bc9b69143952251608",
    "apiKeyLocation": "query",
    "apiKeyName": "key"
  },
  "systemPrompt":"You are a helpful assistant that explains weather information in a clear, conversational way.
You will be given raw weather API JSON data.
Your job:
- Summarize the weather conditions in a natural sentence.
- Include location, temperature (in °C), condition (sunny, cloudy, rainy, etc.), wind speed & direction, and humidity.
- Mention "feels like" temperature if it is different from actual.
- If available, add air quality index in simple terms (e.g., "Good", "Moderate", "Unhealthy").
- Do not show raw JSON or technical details.
- Keep the response concise and friendly.
",
  "enabled": true
}


