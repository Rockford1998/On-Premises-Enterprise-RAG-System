# Copy to .env.dev / .env.test / .env.prod and fill in.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=dev
PORT="3000"

# ---- Databases ----
MONGODB_URL="mongodb://root:root@127.0.0.1:27017/poc?authSource=admin"
DB_NAME="poc"
DB_USER="root"
DB_PASSWORD="root"
DB_HOST="localhost"
DB_PORT="5432"

# ---- Ollama ----
# These names must match what `ollama list` reports AND are auto-registered as
# llmModel records at startup. A name that Ollama does not have pulled causes a
# 404 during document ingestion.
OLLAMA_BASE_URL="http://localhost:11434"
BASE_MODEL="mistral:latest"
TOOL_MODEL="mistral:latest"
# generateEmbedding.ts reads EMBEDDING_MODEL; bot.controller.ts reads
# EMBED_MODEL. Keep both set to the same value.
EMBEDDING_MODEL="nomic-embed-text"
EMBED_MODEL="nomic-embed-text"
TOP_K=4

# Max upload size in bytes (default 25 MB).
MAX_UPLOAD_BYTES=26214400

# ---- Auth / session ----
# Required. The server will not start if these are missing or blank.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

ACCESS_TOKEN_TTL=900          # access token lifetime, seconds (15 min)
REFRESH_TOKEN_TTL=604800      # refresh token lifetime, seconds (7 days)
MAX_SESSIONS_PER_USER=5       # concurrent sessions before the oldest is evicted
LOGIN_MAX_ATTEMPTS=10         # failed logins per email+IP per window
LOGIN_WINDOW_SECONDS=900
REFRESH_COOKIE_NAME="rag_rt"

# Credentialed CORS forbids "*". Comma-separate multiple origins.
CLIENT_ORIGIN="http://localhost:5173"

# ---- Google Drive knowledge-base sync (optional) ----
# Only needed if a bot connects a Google Drive source. Create an OAuth 2.0
# Client ID (Web application) in Google Cloud Console, add
# GOOGLE_OAUTH_REDIRECT_URI as an authorized redirect URI, and enable the
# Drive API for the project.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/kb/connections/google/callback"

# 32-byte key (base64) used to encrypt stored Drive refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""
